{
  "name": "cairnflow-console",
  "private": true,
  "license": "BUSL-1.1",
  "version": "0.1.0",
  "type": "module",
  "description": "Cairnflow web console. Builds into ui/dist, embedded into the binary via the cairn-ui crate.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "test": "vitest run",
    "size": "size-limit",
    "check": "npm run i18n && npm run typecheck && npm run lint && npm run test && npm run build && npm run size",
    "e2e": "playwright test",
    "demo": "node demo/seed.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "gen:api": "node scripts/gen-api.ts",
    "gen:tables": "node scripts/gen-tables.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "lucide-react": "1.63.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@inlang/paraglide-js": "2.29.2",
    "@inlang/plugin-message-format": "4.5.5",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "shadcn": "4.23.0",
    "size-limit": "14.3.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
